{
  "name": "nuxt-app",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:js": "eslint --ext \".ts,.vue\" --ignore-path .eslintignore .",
    "lint:prettier": "prettier --check . --ignore-path .prettierignore",
    "lint": "bun run lint:js && bun run lint:prettier",
    "lintfix": "prettier --write --list-different . --ignore-path .prettierignore && bun run lint:js --fix"
  },
  "devDependencies": {
    "@nuxt/image": "^1.8.1",
    "@nuxt/ui": "^4.0.0",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/node": "^24.5.2",
    "nuxt": "^4.1.2"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.2",
    "@tanstack/vue-query": "^5.90.2",
    "@vercel/analytics": "^1.3.1",
    "@vercel/blob": "^2.0.0",
    "@vueuse/nuxt": "^13.9.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fuse.js": "^7.1.0",
    "image-size": "^2.0.2",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4"
  }
}
